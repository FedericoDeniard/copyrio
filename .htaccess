Redirect 301 /cpanel https://copyrio.com.ar:2222/

RewriteEngine On

# Serve everything from /dist (Vite build output)
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ /dist/$1 [L]

# Long cache for fingerprinted Vite assets (immutable safe due to content hash).
# Vite/Rollup hashes are base62 (a-z, A-Z, 0-9) and may include underscores, so we match
# the extension with a permissive basename filter on the file's basename only.
<FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Images and fonts inside /dist/imagenes get a 7-day cache
<FilesMatch "\.(png|jpe?g|gif|webp|svg|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=604800"
</FilesMatch>

# Service worker (future-proofing)
<FilesMatch "sw\.js$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# ─── Security headers ────────────────────────────────────────────────────────────
# HSTS: 1 year, include subdomains, eligible for preload. Requires HTTPS.
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Prevent MIME-type sniffing.
Header always set X-Content-Type-Options "nosniff"

# Referrer policy: send only the origin on cross-origin requests.
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Cross-Origin-Opener-Policy: isolate the browsing context.
Header always set Cross-Origin-Opener-Policy "same-origin"

# Disable powerful features we don't use to shrink the attack surface.
Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

# Content Security Policy. Mirrors what the app actually loads:
#  - default-src 'self'                                (only same-origin by default)
#  - script-src 'self' + cloudflare beacon + 'unsafe-inline'
#    (the inline <script> in <head> sets media='all' on the Google Fonts CSS)
#  - style-src  'self' + Google Fonts + 'unsafe-inline'
#    (Tailwind v4 + a small <style> block in index.html use inline styles)
#  - font-src   'self' + Google Fonts gstatic
#  - img-src    'self' data:
#  - connect-src 'self' + Cloudflare beacon endpoint (browser sends beacons via fetch)
#  - frame-ancestors 'none'                            (replaces X-Frame-Options DENY)
#  - form-action 'self' mailto:                        (contact form uses mailto:)
#  - base-uri   'self'
#  - object-src 'none'
#  - upgrade-insecure-requests                        (force https on mixed content)
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://static.cloudflareinsights.com https://cloudflareinsights.com; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'none'; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

